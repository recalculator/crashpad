{
  "name": "crashpad",
  "version": "0.1.0",
  "description": "Checks whether backend changes break an application's PostgreSQL behavior, proposes verified fixes, and opens draft fix PRs.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "crashpad": "bin/crashpad.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "crashpad": "node bin/crashpad.js"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "diff": "^9.0.0",
    "libpg-query": "^18.3.0",
    "pg": "^8.23.1",
    "pg-cursor": "^2.22.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "@types/pg": "^8.23.1",
    "@types/pg-cursor": "^2.7.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  }
}
