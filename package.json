{
  "name": "crashpad",
  "version": "0.3.0",
  "description": "Checks whether a backend change breaks database, API contract, configuration/startup, permission, or workflow behavior; repairs with independent verification and draft fix PRs.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "crashpad": "bin/crashpad.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE",
    "docs/third-party.md",
    "deploy"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "crashpad": "node bin/crashpad.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "diff": "^9.0.0",
    "libpg-query": "^18.3.0",
    "pg": "^8.23.1",
    "pg-cursor": "^2.22.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "@types/pg": "^8.23.1",
    "@types/pg-cursor": "^2.7.2",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  }
}
