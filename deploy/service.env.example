# /etc/crashpad/service.env (mode 600, owner crashpad). `crashpad service register`
# writes this file for you with the real values; this example lists every setting.
CRASHPAD_GITHUB_APP_ID=123456
CRASHPAD_GITHUB_CLIENT_ID=Iv23xxxxxxxxxxxxxxxx
CRASHPAD_GITHUB_APP_SLUG=crashpad-yourname
CRASHPAD_GITHUB_PRIVATE_KEY_FILE=/etc/crashpad/app.private-key.pem
CRASHPAD_GITHUB_WEBHOOK_SECRET=replace-with-the-apps-webhook-secret
CRASHPAD_SERVICE_DATA=/var/lib/crashpad/state.json
# Leave unset for github.com:
# CRASHPAD_GITHUB_API_URL=
# CRASHPAD_GITHUB_URL=
